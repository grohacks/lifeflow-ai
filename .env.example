# LifeFlow AI - Environment Configuration
# ============================================================
# DATABASE (MySQL 8.x)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lifeflow
DB_USERNAME=root
DB_PASSWORD=root

# When running in Docker, the backend can reach the host machine MySQL via:
# DB_HOST=host.docker.internal

# ============================================================
# CACHE (Redis)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================
# MESSAGING (Eclipse Mosquitto MQTT)
# ============================================================
MQTT_HOST=localhost
MQTT_PORT=1883

# ============================================================
# SECURITY / JWT
# ============================================================
JWT_SECRET=lifeflow_emergency_digital_twin_super_secure_jwt_secret_key_2026_at_least_256_bits_length!
JWT_EXPIRATION_MS=86400000

# ============================================================
# SERVICE ENDPOINTS
# ============================================================
AI_SERVICE_URL=http://localhost:8000
EDGE_GATEWAY_URL=http://localhost:8081
BACKEND_URL=http://localhost:8080
FRONTEND_PORT=5173

# ============================================================
# DEMO / SEED CREDENTIALS
# ============================================================
SEED_ADMIN_PASSWORD=admin123
SEED_PARAMEDIC_PASSWORD=paramedic123
SEED_CONTROL_PASSWORD=control123
SEED_HOSPITAL_PASSWORD=hospital123
SEED_CLINICIAN_PASSWORD=clinician123
